git() {
  if [[ "$1" == "push" ]]; then
    local output
    output=$(command git push "${@:2}" 2>&1)
    echo "$output"
    local url
    url=$(echo "$output" | grep -oE 'https://github\.com/[^ ]+/pull/new/[^ ]+')
    if [[ -n "$url" ]]; then
      open "$url"
    fi
  else
    command git "$@"
  fi
}
